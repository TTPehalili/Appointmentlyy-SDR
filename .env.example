NEXT_PUBLIC_SUPABASE_URL=https://uxxswbukdhdxmylrjoej.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/bpogtm/30min

AUTH_SECRET=generate_a_random_48_byte_base64_string
NEXT_PUBLIC_APP_URL=https://app.appointmentlyy.com
AUTH_ADMIN_EMAILS=emil@appointmentlyy.com

# Client workspaces, members and passwords are stored in Supabase when SUPABASE_SERVICE_ROLE_KEY is set
# (run supabase/migrations/20261110000000_tenants_and_members.sql first). Without it they are saved in
# a local file, TENANCY_DATA_DIR/tenancy.json (default ./.data): fine on one long-running server,
# not on serverless hosts.
# TENANCY_DATA_DIR=./.data

# Demo builds only: browser-only password login, role switching and sample data for screenshots.
# NEVER set this in production: it turns off the sign-in gate.
# NEXT_PUBLIC_DEMO_LOGIN=1

# VICIdial click-to-call (server only; never prefix with NEXT_PUBLIC_)
# VICIDIAL_URL is the main VICIdial HTTPS site (not the :446 access portal). This server's public IP
# must be allow-listed in the VICIdial firewall.
VICIDIAL_URL=
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
# Time zone of the VICIdial server clock, for callback times (IANA name)
VICIDIAL_TIMEZONE=UTC
# Workspace codes allowed to use the shared VICIdial account (comma-separated, or *). Unset: the
# platform workspace only. Each person also needs an agent linked in Admin > Phone system.
VICIDIAL_TENANTS=
